on property:ro.boot.hwc=GLOBAL
    enable vendor.nfc_hal_service

on property:ro.boot.hwc=CN
    enable vendor.nfc_hal_service
    setprop bluetooth.device.default_name "Redmi K20"

on property:ro.boot.hwc=INDIA
    setprop bluetooth.device.default_name "Redmi K20"

service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.nxp
    override
    class early_hal
    user nfc
    group nfc drmrpc system
    disabled
